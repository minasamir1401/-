# Dokploy Internal Postgres URL (recommended when Web and Postgres are on the same Dokploy host/network):
DATABASE_URL="postgresql://postgres:<PASSWORD>@red-gate-js-faufep:5432/postgres?schema=public&connection_limit=10"

# External / Local Postgres URL example:
# DATABASE_URL="postgresql://postgres@127.0.0.1:5432/orthodox_portal?schema=public"

# Server bind configuration (used in production containers):
PORT=3000
HOSTNAME=0.0.0.0

# Optional Gemini AI keys (also loaded automatically from AiApiKey table in PostgreSQL):
GEMINI_API_KEYS=""
GEMINI_MODEL="gemini-3.5-flash"
